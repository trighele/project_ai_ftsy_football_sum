{
    "name": "local-ff_summary",
    "dockerComposeFile": "./docker-compose.local.yml",
    "service": "local-dev",
    "workspaceFolder": "/home/build/app",
    "mounts": ["source=${localEnv:USERPROFILE}\\.claude,target=/root/.claude,type=bind"],
    "customizations": {
        "vscode": {
            "extensions": [
                "anthropic.claude-code",
                "ms-python.python",
                "ms-python.vscode-python-envs",
                "ms-python.vscode-pylance"
            ]
        }
    },
    "forwardPorts": [8000],
    "remoteUser": "root",
    "remoteEnv": {
        "UV_LINK_MODE": "copy",
        "IS_SANDBOX": "1"
    },
    "postCreateCommand": "bash .devcontainer/setup.sh"
}
