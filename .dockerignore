# Everything the image does not need. Note what is *not* here: pyproject.toml,
# uv.lock, and README.md all go in, because `uv sync` builds the project and
# hatchling reads the readme named in pyproject.toml.

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/

# Virtual environments and local tooling
.env
.env.*
.venv/
venv/
ENV/
.tools/

# Application data (see FFSUM_DATA_DIR)
data/

# Version control and CI
.git/
.gitignore
.github/

# Agent and planning material
.agents/
.claude/
.devcontainer/
.scratch/
CLAUDE.md
CONTEXT.md

# Not part of the runtime
tests/
notebooks/
docs/
deployment/
scripts/
project_ai_ftsy_football_sum/assets/

# Testing and type-checking caches
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Docker
Dockerfile
.dockerignore
docker-compose*.yml

# Logs
*.log
logs/
